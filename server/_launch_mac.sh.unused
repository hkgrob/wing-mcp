#!/bin/sh
# macOS launcher for the WING MCP server.
#
# Claude Desktop starts MCP servers with a minimal PATH, so a bare `python3`
# usually resolves to Apple's /usr/bin/python3 (3.9 on most Macs), which the
# mcp package does not support, even when a newer Homebrew or python.org
# Python is installed. This tries the usual install locations in order and
# runs the first interpreter that is 3.10+ AND can import mcp.
#
# To force one: set WING_MCP_PYTHON to its full path, e.g.
#   launchctl setenv WING_MCP_PYTHON /opt/homebrew/bin/python3.12
DIR="$(cd "$(dirname "$0")" && pwd)"
for py in \
    "$WING_MCP_PYTHON" \
    /opt/homebrew/bin/python3.13 /opt/homebrew/bin/python3.12 \
    /opt/homebrew/bin/python3.11 /opt/homebrew/bin/python3 \
    /usr/local/bin/python3.13 /usr/local/bin/python3.12 \
    /usr/local/bin/python3.11 /usr/local/bin/python3 \
    /Library/Frameworks/Python.framework/Versions/Current/bin/python3 \
    "$HOME/.pyenv/shims/python3" "$HOME/.local/bin/python3" \
    python3.13 python3.12 python3.11 python3.10 python3 /usr/bin/python3
do
    [ -n "$py" ] || continue
    command -v "$py" >/dev/null 2>&1 || continue
    if "$py" -c 'import sys; assert sys.version_info >= (3, 10); import mcp.server.fastmcp' >/dev/null 2>&1; then
        exec "$py" "$DIR/server.py" "$@"
    fi
done
echo "wing-mcp: no Python 3.10+ with the mcp package was found." >&2
echo "Install one, e.g.  brew install python@3.12 && /opt/homebrew/bin/python3.12 -m pip install --break-system-packages 'mcp<2'" >&2
echo "or set WING_MCP_PYTHON to the interpreter to use." >&2
exit 1
